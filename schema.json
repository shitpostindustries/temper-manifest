{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:temper:catalog:1",
  "title": "temper app catalog",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later. ids end up as winget arguments in an elevated process, so the pattern stays strict",
  "type": "object",
  "required": ["schema_version", "apps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "required": ["id", "name", "source", "group"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source": { "enum": ["winget", "msstore"] },
        "group": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 ]{0,31}$" }
      }
    }
  }
}
